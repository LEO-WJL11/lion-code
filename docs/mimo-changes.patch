+import type { TuiPlugin, TuiPluginApi, TuiPluginModule } from "@mimo-ai/plugin/tui"
+import { For, Show, createMemo, createResource } from "solid-js"
+import { useRoute } from "@tui/context/route"
+import { useSDK } from "@tui/context/sdk"
+import { useSync } from "@tui/context/sync"
+import { Locale } from "@/util"
+import { appendFileSync } from "node:fs"
+
+const id = "internal:sidebar-sessions"
+
+// 【临时诊断】模块体执行 = 这个插件文件确实被加载了（区别于"加载了但没渲染"）。
+try {
+  appendFileSync("C:/Users/Leo/Desktop/lion-code/.lbcheck/sidebar-sessions.log",
+    `${new Date().toISOString()} module-loaded\n`)
+} catch {
+  // 诊断用，失败无所谓
+}
+
+/** 侧栏宽度只有 42 列，行数太多会把下面的插件挤走，这里封顶。 */
+const MAX_ROWS = 15
+
+function stamp(ms: number) {
+  const date = new Date(ms)
+  const now = new Date()
+  // 侧栏窄，今天只给时间，往日只给月/日
+  if (date.toDateString() === now.toDateString()) return Locale.time(ms)
+  return `${date.getMonth() + 1}/${date.getDate()}`
+}
+
+function View(props: { api: TuiPluginApi }) {
+  const theme = () => props.api.theme.current
+  const route = useRoute()
+  const sdk = useSDK()
+  const sync = useSync()
+
+  // 【为什么自己拉而不读 sync.data.session】sync 只在 `args.continue` 时才请求
+  // 会话列表（context/sync.tsx），否则那个数组只累积"本次 TUI 见过的会话"，
+  // 开机后基本是空的。所以列表得由这里自己经 session.list 取一次；
+  // 再并上 sync 里的（那是本进程内新建/更新的，保证刚发的消息立刻反映出来）。
+  const [fetched] = createResource(async () => {
+    const result = await sdk.client.session.list({ roots: true })
+    return result.data ?? []
+  })
+
+  const sessions = createMemo(() => {
+    const seen = new Set<string>()
+    const merged = [...(fetched() ?? []), ...sync.data.session].filter((x) => {
+      if (seen.has(x.id)) return false
+      seen.add(x.id)
+      return true
+    })
+    return merged
+      // 【必须是 == null，不能写 === undefined】适配层返回的会话 parentID 是
+      // `null`（实测 18/18），而 `null !== undefined` 为 true —— 用 === undefined
+      // 判断时这一行看着对、类型也过，实际把**所有**会话都滤掉了，列表永远空。
+      // 这也是 AGENTS.md 明写的约定：判空用 == null，别用 === undefined。
+      .filter((x) => x.parentID == null)
+      .toSorted((a, b) => b.time.updated - a.time.updated)
+      .slice(0, MAX_ROWS)
+  })
+
+  const current = createMemo(() => (route.data.type === "session" ? route.data.sessionID : undefined))
+
+  // 【临时】渲染证明：确认这个插槽真的会渲染本插件（查完删掉）。
+  try {
+    appendFileSync("C:/Users/Leo/Desktop/lion-code/.lbcheck/sidebar-sessions.log",
+      `render fetched=${(fetched() ?? []).length} sync=${sync.data.session.length} rows=${sessions().length}\n`)
+  } catch {
+    // 诊断用，失败无所谓
+  }
+
+  return (
+    <Show when={sessions().length > 0}>
+      <box>
+        <text fg={theme().text}>
+          <b>会话</b>
+        </text>
+        <For each={sessions()}>
+          {(item) => (
+            <box
+              flexDirection="row"
+              gap={1}
+              justifyContent="space-between"
+              onMouseDown={() => route.navigate({ type: "session", sessionID: item.id })}
+            >
+              <text fg={item.id === current() ? theme().text : theme().textMuted} wrapMode="none">
+                {item.id === current() ? "• " : "  "}
+                {Locale.truncate(item.title || "新会话", 24)}
+              </text>
+              <text fg={theme().textMuted} wrapMode="none">
+                {stamp(item.time.updated)}
+              </text>
+            </box>
+          )}
+        </For>
+      </box>
+    </Show>
+  )
+}
+
+const tui: TuiPlugin = async (api) => {
+  // 【临时诊断】证明 activatePluginEntry 真的调到了本插件的 tui()
+  try {
+    appendFileSync("C:/Users/Leo/Desktop/lion-code/.lbcheck/sidebar-sessions.log",
+      `${new Date().toISOString()} tui()-called\n`)
+  } catch {
+    // 诊断用
+  }
+  api.slots.register({
+    // 排在 cwd(125) 之前，会话列表应当在侧栏最上方
+    order: 110,
+    slots: {
+      sidebar_content() {
+        // 【临时诊断】证明插槽确实来取过本插件的内容
+        try {
+          appendFileSync("C:/Users/Leo/Desktop/lion-code/.lbcheck/sidebar-sessions.log",
+            `${new Date().toISOString()} slot-factory-called\n`)
+        } catch {
+          // 诊断用
+        }
+        return <View api={api} />
+      },
+    },
+  })
+}
+
+const plugin: TuiPluginModule & { id: string } = {
+  id,
+  tui,
+}
+
+export default plugin
