diff --git a/MiMo-Code-main/packages/cli/src/util/win-folder-picker.ts b/MiMo-Code-main/packages/cli/src/util/win-folder-picker.ts
new file mode 100644
index 0000000..6c16b03
--- /dev/null
+++ b/MiMo-Code-main/packages/cli/src/util/win-folder-picker.ts
@@ -0,0 +1,37 @@
+/**
+ * 【本仓库新增】Windows 原生文件夹选择框。
+ *
+ * 为什么不用手打路径：TUI 里让用户敲 `C:\Users\…\测试` 又长又容易错，
+ * 用户要的是资源管理器那种标准窗口 —— 这里用 PowerShell 拉起
+ * `System.Windows.Forms.FolderBrowserDialog`（Win11 上是新版树形界面）。
+ *
+ * 【必须 -STA】不加这个开关，Windows Forms 的弹框会直接挂住（经典坑）。
+ *
+ * 返回值约定（不用 try/catch，靠返回值判断 —— 见 AGENTS.md）：
+ *   path 非空        → 用户选了目录
+ *   path 空 + code 0 → 用户取消
+ *   path 空 + code≠0 → 拉起失败，error 里是原因（调用方要提示，别静默 ✗）
+ */
+export async function pickWindowsFolder(title: string) {
+  // 标题里可能有单引号，PowerShell 单引号字符串的转义是写两遍
+  const safe = title.replace(/'/g, "''")
+  const script = [
+    "Add-Type -AssemblyName System.Windows.Forms;",
+    // 路径可能含中文，输出按 UTF-8 编，否则读回来是乱码 ✗
+    "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8;",
+    "$f = New-Object System.Windows.Forms.FolderBrowserDialog;",
+    `$f.Description = '${safe}';`,
+    "$f.ShowNewFolderButton = $true;",
+    "if ($f.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK)",
+    "{ [Console]::Out.Write($f.SelectedPath) }",
+  ].join(" ")
+
+  const proc = Bun.spawn(["powershell", "-NoProfile", "-STA", "-Command", script], {
+    stdout: "pipe",
+    stderr: "pipe",
+  })
+  const [out, err] = await Promise.all([new Response(proc.stdout).text(), new Response(proc.stderr).text()])
+  const code = await proc.exited
+
+  return { path: out.trim(), code, error: err.trim() }
+}
