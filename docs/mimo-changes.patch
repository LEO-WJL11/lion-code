+++ b/MiMo-Code-main/packages/cli/src/cli/cmd/tui/component/dialog-workspace-list.tsx
@@ -0,0 +1,133 @@
+import { DialogSelect } from "@tui/ui/dialog-select"
+import { useDialog } from "@tui/ui/dialog"
+import { useSDK } from "@tui/context/sdk"
+import { useSync } from "@tui/context/sync"
+import { useRoute } from "@tui/context/route"
+import { useProject } from "@tui/context/project"
+import { useToast } from "@tui/ui/toast"
+import { onMount } from "solid-js"
+import { DialogWorkspaceCreate, openWorkspaceSession } from "./dialog-workspace-create"
+
+/**
+ * 【本仓库新增】工作区选择器 —— 同时服务于 `/workspaces` 和 `/new`。
+ *
+ * MiMo 自带"新建工作区"的组件（`DialogWorkspaceCreate`），但没有把"新建"并进
+ * 选择流程：会话列表里那个入口藏在 ctrl+w 键位后面。这里让**新建工作区成为
+ * 列表第一项**，两个命令都能直接建。
+ *
+ * 两种用法（`mode`）：
+ *   · `"select"`（`/workspaces`）：选一个工作区切过去，并在那边开一个会话。
+ *   · `"new"`（`/new`）：在选定的工作区里**开新对话**。只有一个工作区时
+ *     直接用它，不再多问一步。
+ *
+ * 【数据源】`useProject().workspace`（对应适配层的 `GET /experimental/workspace`）：
+ * `list()` 取数组、`get(id)` 按 id 找、`current()` 当前、`sync()` 重新拉取。
+ * 注意 `DialogSelect` **自己会调 `option.onSelect(dialog)`**，所以这里不能再用
+ * 对话框级的 `onSelect` 兜底，否则每次选择都会执行两遍。
+ */
+export function DialogWorkspaceList(props: { mode?: "select" | "new" }) {
+  const dialog = useDialog()
+  const sdk = useSDK()
+  const sync = useSync()
+  const route = useRoute()
+  const project = useProject()
+  const toast = useToast()
+
+  const open = (workspaceID: string) =>
+    openWorkspaceSession({ dialog, route, sdk, sync, toast, workspaceID })
+
+  function createWorkspace() {
+    dialog.replace(() => (
+      <DialogWorkspaceCreate
+        onSelect={async (workspaceID) => {
+          // 新建的工作区立刻进列表，这样返回选择器时能看到它
+          await project.workspace.sync().catch(() => undefined)
+          await open(workspaceID)
+        }}
+      />
+    ))
+  }
+
+  /**
+   * 删除工作区 —— 语义是**从应用里注销**，不是删磁盘上的目录。
+   * 适配层只清理它自己建的空目录（`<workspace_root>/workspaces/<name>`），
+   * 用户注册进来的真实项目目录一律不碰 —— 否则就是删用户的代码。
+   */
+  async function removeWorkspace(workspaceID: string, label: string) {
+    const result = await sdk.client.experimental.workspace
+      .remove({ id: workspaceID })
+      .catch(() => undefined)
+    if (!result) {
+      toast.show({ message: `删除工作区失败：${label}`, variant: "error" })
+      return
+    }
+    await project.workspace.sync().catch(() => undefined)
+    toast.show({ message: `已注销工作区：${label}`, variant: "success" })
+    // 列表变了，重开一次选择器让用户看到结果
+    dialog.replace(() => <DialogWorkspaceList mode={props.mode} />)
+  }
+
+  onMount(() => {
+    void (async () => {
+      // 先把列表拉全，再决定要不要跳过选择 —— 否则启动瞬间列表还是空的，
+      // 会把"只有一个工作区"误判成"没有工作区"。
+      await project.workspace.sync().catch(() => undefined)
+      if (props.mode !== "new") return
+      const spaces = project.workspace.list()
+      if (spaces.length === 1) {
+        await open(spaces[0].id)
+        return
+      }
+      if (spaces.length === 0) {
+        // 一个都没有：退回原来的"新建对话"行为（回首页，发第一条消息时建会话）
+        route.navigate({ type: "home" })
+        dialog.clear()
+      }
+    })()
+  })
+
+  const options = () => {
+    const current = project.workspace.current()
+    return [
+      {
+        title: "＋ 新建工作区",
+        value: "__create__",
+        description: "建好之后直接在里面开始对话",
+        keywords: ["new", "create", "workspace", "xinjian", "gongzuoqu"],
+        footer: "ctrl+w",
+        onSelect: () => createWorkspace(),
+      },
+      ...project.workspace.list().flatMap((workspace) => {
+        const label = workspace.name || workspace.id
+        return [
+          {
+            title: label,
+            value: workspace.id,
+            description: [workspace.id === current ? "● 当前" : undefined, workspace.directory]
+              .filter(Boolean)
+              .join("   "),
+            keywords: [workspace.id, workspace.directory].filter(Boolean) as string[],
+            onSelect: () => void open(workspace.id),
+          },
+          // 【删除入口】每个工作区后面跟一条删除项（挂在列表项上，不新造命令）。
+          // 会话列表的删除是 ctrl+d + 按两次确认；这里直接选就行 —— 语义是"注销"，
+          // 不会碰磁盘上的目录，误操作代价低。
+          {
+            title: `删除工作区：${label}`,
+            value: `__delete__:${workspace.id}`,
+            description: "从应用里注销（不会删除磁盘上的目录）",
+            keywords: ["delete", "remove", "shanchu", workspace.id],
+            onSelect: () => void removeWorkspace(workspace.id, label),
+          },
+        ]
+      }),
+    ]
+  }
+
+  return (
+    <DialogSelect
+      title={props.mode === "new" ? "新建对话 · 选择工作区" : "选择工作区"}
+      options={options()}
+    />
+  )
+}
